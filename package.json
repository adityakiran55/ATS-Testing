{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "node tests/api.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vsolutions-ats --local",
    "db:seed": "wrangler d1 execute vsolutions-ats --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler && npm run db:migrate:local && npm run db:seed"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
